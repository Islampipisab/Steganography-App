[Unit]
Description=Steganography Web App (Gunicorn)
After=network.target

[Service]
User=root
WorkingDirectory=/root/stego_project
Environment="PATH=/root/stego_project/venv/bin"
# SciPy/NumPy use OpenBLAS; many BLAS threads + Gunicorn gthread can deadlock → accept on :5000 but 0 bytes (curl timeout).
Environment="OPENBLAS_NUM_THREADS=1"
Environment="OMP_NUM_THREADS=1"
Environment="MKL_NUM_THREADS=1"
# gthread + threads: long hide/extract must not use every thread or GET / queues forever (0 bytes until timeout).
# 24 slots reduces "site dead" when several users run long hide/extract at once (was 8).
ExecStart=/root/stego_project/venv/bin/gunicorn -k gthread -w 1 --threads 24 -b 127.0.0.1:5000 --timeout 600 --graceful-timeout 30 "web.app:app" --chdir /root/stego_project
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
